{
  "primitives": {
    "color": {
      "white": "#FFFFFF",
      "blue-50": "#EFF6FF",
      "blue-100": "#DBEAFE",
      "blue-200": "#BFDBFE",
      "blue-300": "#93C5FD",
      "blue-400": "#60A5FA",
      "brand": "#1B4F8A",
      "ink": "#0F2D52",
      "navy": "#0B2447",
      "night": "#0B1423",
      "night-surface": "#142239",
      "night-raised": "#1B304C",
      "night-footer": "#080F1C",
      "sky-400": "#38BDF8",
      "sky-500": "#0EA5E9",
      "slate-200": "#E2E8F0",
      "slate-300": "#CBD5E1",
      "slate-400": "#94A3B8",
      "slate-500": "#64748B",
      "slate-600": "#52647B",
      "slate-700": "#425774",
      "red-50": "#FEF3F2",
      "red-200": "#FECDCA",
      "red-700": "#B42318",
      "red-950": "#3D1B23",
      "green-50": "#F0FDF4",
      "green-300": "#86EFAC",
      "green-700": "#15803D",
      "green-950": "#102C24"
    },
    "space": {
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "7": "1.75rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "14": "3.5rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem"
    },
    "font": {
      "sans": "Inter, system-ui, sans-serif",
      "weight-regular": 400,
      "weight-medium": 500,
      "weight-semibold": 600,
      "weight-bold": 700,
      "weight-extrabold": 800,
      "size-caption": "0.75rem",
      "size-eyebrow": "0.8125rem",
      "size-small": "0.875rem",
      "size-label": "0.9375rem",
      "size-body": "1rem",
      "size-lead": "1.125rem",
      "size-card-title": "1.25rem",
      "size-price": "1.5rem",
      "size-section": "1.875rem",
      "size-section-wide": "2.25rem",
      "size-hero": "2.5rem",
      "size-hero-medium": "3rem",
      "size-hero-wide": "4rem",
      "leading-tight": 1.05,
      "leading-snug": 1.375,
      "leading-body": 1.5,
      "leading-relaxed": 1.625
    },
    "radius": {
      "control": "0.625rem",
      "card": "1rem",
      "pill": "9999px"
    },
    "shadow": {
      "card": "0 1px 2px rgb(15 45 82 / 0.05), 0 8px 24px -12px rgb(15 45 82 / 0.12)",
      "lift": "0 2px 4px rgb(15 45 82 / 0.06), 0 20px 40px -16px rgb(27 79 138 / 0.28)",
      "dark-card": "0 1px 2px rgb(0 0 0 / 0.24), 0 8px 24px -12px rgb(0 0 0 / 0.45)",
      "dark-lift": "0 2px 4px rgb(0 0 0 / 0.26), 0 20px 40px -16px rgb(0 0 0 / 0.6)"
    },
    "size": {
      "container": "77.5rem",
      "touch-min": "2.75rem",
      "search-height": "3.5rem",
      "header-small": "4rem",
      "header-wide": "4.5rem",
      "scroll-offset": "5.5rem",
      "focus-width": "3px",
      "focus-offset": "2px",
      "cover-ratio": "5 / 3"
    },
    "motion": {
      "fast": "200ms"
    },
    "breakpoint": {
      "sm": "40rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "80rem",
      "2xl": "96rem"
    }
  },
  "semantic": {
    "shared": {
      "text-font": "{primitives.font.sans}",
      "layout-gutter": "{primitives.space.5}",
      "layout-gutter-wide": "{primitives.space.8}",
      "layout-content-max": "{primitives.size.container}",
      "layout-card-gap": "{primitives.space.6}",
      "control-target": "{primitives.size.touch-min}",
      "control-radius": "{primitives.radius.control}",
      "focus-width": "{primitives.size.focus-width}",
      "focus-offset": "{primitives.size.focus-offset}",
      "transition-fast": "{primitives.motion.fast}"
    },
    "light": {
      "color-page": "{primitives.color.white}",
      "color-surface": "{primitives.color.white}",
      "color-surface-raised": "{primitives.color.white}",
      "color-surface-subtle": "{primitives.color.blue-50}",
      "color-text": "{primitives.color.ink}",
      "color-text-muted": "{primitives.color.slate-600}",
      "color-text-interactive": "{primitives.color.brand}",
      "color-border-subtle": "{primitives.color.slate-200}",
      "color-border-control": "{primitives.color.slate-500}",
      "color-border-hover": "{primitives.color.brand}",
      "color-accent": "{primitives.color.sky-500}",
      "color-focus": "{primitives.color.brand}",
      "color-primary": "{primitives.color.brand}",
      "color-primary-hover": "{primitives.color.ink}",
      "color-primary-active": "{primitives.color.navy}",
      "color-on-primary": "{primitives.color.white}",
      "color-interactive-hover": "{primitives.color.blue-100}",
      "color-interactive-active": "{primitives.color.blue-200}",
      "color-disabled-bg": "{primitives.color.slate-200}",
      "color-disabled-text": "{primitives.color.slate-600}",
      "color-error": "{primitives.color.red-700}",
      "color-error-bg": "{primitives.color.red-50}",
      "color-success": "{primitives.color.green-700}",
      "color-success-bg": "{primitives.color.green-50}",
      "color-footer-bg": "{primitives.color.navy}",
      "color-footer-text": "{primitives.color.white}",
      "color-footer-muted": "{primitives.color.slate-300}",
      "color-footer-hover": "{primitives.color.ink}",
      "color-footer-focus": "{primitives.color.blue-300}",
      "color-footer-border": "{primitives.color.slate-400}",
      "color-hero-start": "{primitives.color.blue-50}",
      "shadow-surface": "{primitives.shadow.card}",
      "shadow-raised": "{primitives.shadow.lift}"
    },
    "dark": {
      "color-page": "{primitives.color.night}",
      "color-surface": "{primitives.color.night-surface}",
      "color-surface-raised": "{primitives.color.night-raised}",
      "color-surface-subtle": "{primitives.color.night-surface}",
      "color-text": "{primitives.color.blue-50}",
      "color-text-muted": "{primitives.color.slate-300}",
      "color-text-interactive": "{primitives.color.blue-300}",
      "color-border-subtle": "{primitives.color.slate-700}",
      "color-border-control": "{primitives.color.slate-400}",
      "color-border-hover": "{primitives.color.blue-300}",
      "color-accent": "{primitives.color.sky-400}",
      "color-focus": "{primitives.color.blue-300}",
      "color-primary": "{primitives.color.blue-300}",
      "color-primary-hover": "{primitives.color.blue-200}",
      "color-primary-active": "{primitives.color.blue-400}",
      "color-on-primary": "{primitives.color.ink}",
      "color-interactive-hover": "{primitives.color.night-raised}",
      "color-interactive-active": "{primitives.color.slate-700}",
      "color-disabled-bg": "{primitives.color.night-raised}",
      "color-disabled-text": "{primitives.color.slate-300}",
      "color-error": "{primitives.color.red-200}",
      "color-error-bg": "{primitives.color.red-950}",
      "color-success": "{primitives.color.green-300}",
      "color-success-bg": "{primitives.color.green-950}",
      "color-footer-bg": "{primitives.color.night-footer}",
      "color-footer-text": "{primitives.color.blue-50}",
      "color-footer-muted": "{primitives.color.slate-300}",
      "color-footer-hover": "{primitives.color.night-raised}",
      "color-footer-focus": "{primitives.color.blue-300}",
      "color-footer-border": "{primitives.color.slate-400}",
      "color-hero-start": "{primitives.color.night-raised}",
      "shadow-surface": "{primitives.shadow.dark-card}",
      "shadow-raised": "{primitives.shadow.dark-lift}"
    }
  },
  "components": {
    "header": {
      "bg": "{semantic.color-surface}",
      "border": "{semantic.color-border-subtle}",
      "text": "{semantic.color-text}",
      "hover": "{semantic.color-interactive-hover}",
      "active": "{semantic.color-interactive-active}",
      "focus": "{semantic.color-focus}",
      "height-small": "{primitives.size.header-small}",
      "height-wide": "{primitives.size.header-wide}",
      "scroll-offset": "{primitives.size.scroll-offset}"
    },
    "hero": {
      "gradient-start": "{semantic.color-hero-start}",
      "gradient-end": "{semantic.color-page}",
      "title": "{semantic.color-text}",
      "copy": "{semantic.color-text-muted}"
    },
    "button": {
      "bg": "{semantic.color-primary}",
      "hover": "{semantic.color-primary-hover}",
      "active": "{semantic.color-primary-active}",
      "text": "{semantic.color-on-primary}",
      "focus": "{semantic.color-focus}",
      "disabled-bg": "{semantic.color-disabled-bg}",
      "disabled-text": "{semantic.color-disabled-text}",
      "radius": "{semantic.control-radius}"
    },
    "input": {
      "bg": "{semantic.color-surface}",
      "text": "{semantic.color-text}",
      "placeholder": "{semantic.color-text-muted}",
      "border": "{semantic.color-border-control}",
      "border-hover": "{semantic.color-border-hover}",
      "focus": "{semantic.color-focus}",
      "invalid": "{semantic.color-error}",
      "invalid-bg": "{semantic.color-error-bg}",
      "disabled-bg": "{semantic.color-disabled-bg}",
      "disabled-text": "{semantic.color-disabled-text}"
    },
    "search": {
      "panel": "{semantic.color-surface-subtle}",
      "height": "{primitives.size.search-height}"
    },
    "pill": {
      "bg": "{semantic.color-surface}",
      "text": "{semantic.color-text}",
      "border": "{semantic.color-border-control}",
      "hover": "{semantic.color-interactive-hover}",
      "active": "{semantic.color-interactive-active}",
      "selected-bg": "{semantic.color-primary}",
      "selected-text": "{semantic.color-on-primary}",
      "focus": "{semantic.color-focus}",
      "radius": "{primitives.radius.pill}"
    },
    "appearance": {
      "bg": "{components.input.bg}",
      "text": "{components.input.text}",
      "border": "{components.input.border}",
      "focus": "{components.input.focus}",
      "hover": "{components.input.border-hover}"
    },
    "card": {
      "bg": "{semantic.color-surface-raised}",
      "text": "{semantic.color-text}",
      "muted": "{semantic.color-text-muted}",
      "border": "{semantic.color-border-subtle}",
      "hover": "{semantic.color-border-hover}",
      "focus": "{semantic.color-focus}",
      "shadow": "{semantic.shadow-surface}",
      "shadow-hover": "{semantic.shadow-raised}",
      "radius": "{primitives.radius.card}",
      "cover-ratio": "{primitives.size.cover-ratio}"
    },
    "badge": {
      "bg": "{semantic.color-surface-subtle}",
      "text": "{semantic.color-text-interactive}",
      "marker": "{semantic.color-accent}"
    },
    "price": {
      "original": "{semantic.color-text-muted}",
      "current": "{semantic.color-text}"
    },
    "feedback": {
      "empty-bg": "{semantic.color-surface-subtle}",
      "empty-text": "{semantic.color-text}",
      "empty-border": "{semantic.color-border-control}",
      "error-text": "{semantic.color-error}",
      "error-bg": "{semantic.color-error-bg}",
      "success-text": "{semantic.color-success}",
      "success-bg": "{semantic.color-success-bg}"
    },
    "footer": {
      "bg": "{semantic.color-footer-bg}",
      "text": "{semantic.color-footer-text}",
      "muted": "{semantic.color-footer-muted}",
      "hover": "{semantic.color-footer-hover}",
      "focus": "{semantic.color-footer-focus}",
      "border": "{semantic.color-footer-border}"
    }
  }
}
